{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaverssh.dev/schema/terminal-policy.v1.schema.json",
  "title": "WeaverSSH process and terminal action policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default", "actions"],
  "properties": {
    "version": {"const": "weaverssh.terminal-policy.v1"},
    "default": {"const": "deny"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "boundedPolicyValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000\\r\\n]+$"
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "executable", "principals", "sources", "endpoints", "targets", "providers"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "executable": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000\\r\\n\\\\]*$"
        },
        "fixed_args": {
          "type": "array",
          "maxItems": 63,
          "items": {"type": "string", "maxLength": 4096, "pattern": "^[^\\u0000\\r\\n]*$"}
        },
        "environment": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string", "maxLength": 65536, "pattern": "^[^\\u0000\\r\\n]*$"}
        },
        "principals": {"$ref": "#/$defs/boundedPolicyValues"},
        "sources": {"$ref": "#/$defs/boundedPolicyValues"},
        "endpoints": {"$ref": "#/$defs/boundedPolicyValues"},
        "targets": {"$ref": "#/$defs/boundedPolicyValues"},
        "providers": {"$ref": "#/$defs/boundedPolicyValues"},
        "options": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9._-]*$"},
          "additionalProperties": {"$ref": "#/$defs/boundedPolicyValues"}
        },
        "max_args": {"type": "integer", "minimum": 0, "maximum": 63},
        "max_stdin_bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
        "timeout": {"type": "string", "minLength": 1, "maxLength": 32},
        "detach_ttl": {"type": "string", "minLength": 1, "maxLength": 32},
        "replay_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "recording": {"enum": ["off", "best-effort", "required"]}
      }
    }
  }
}
