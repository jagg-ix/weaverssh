{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaverssh.dev/schema/luks-volume-descriptor.v1.schema.json",
  "title": "WeaverSSH Verified LUKS Volume Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "device", "mapping_name", "mapper_path", "expected_type", "detected_type", "uuid", "mount_point", "filesystem", "mount_source", "mount_options", "read_only", "mapper_device", "mount_device", "device_chain", "config_sha256"],
  "properties": {
    "version": {"const": "weaverssh.luks-volume-descriptor.v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9._-]{1,128}$"},
    "device": {"type": "string", "minLength": 1, "maxLength": 4096},
    "mapping_name": {"type": "string", "pattern": "^[a-z0-9._-]{1,128}$"},
    "mapper_path": {"type": "string", "pattern": "^/dev/mapper/[a-z0-9._-]{1,128}$"},
    "expected_type": {"enum": ["luks", "luks1", "luks2"]},
    "detected_type": {"enum": ["luks1", "luks2"]},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "mount_point": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "filesystem": {"type": "string", "minLength": 1, "maxLength": 128},
    "mount_source": {"type": "string", "minLength": 1, "maxLength": 4096},
    "mount_options": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "read_only": {"type": "boolean"},
    "mapper_device": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "mount_device": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "device_chain": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}},
    "export_root": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "staging_root": {"type": "string", "pattern": "^/", "maxLength": 4096},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
