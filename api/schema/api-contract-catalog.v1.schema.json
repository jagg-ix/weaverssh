{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaverssh.dev/schema/api-contract-catalog.v1.schema.json",
  "title": "WeaverSSH API Contract Catalog",
  "type": "object",
  "required": ["version", "name", "revision", "contracts"],
  "properties": {
    "version": {"const": "weaverssh.api-contract-catalog.v1"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contract": {
      "type": "object",
      "required": ["id", "contract_version", "kind", "path", "stability", "compatibility"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "contract_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "kind": {"enum": ["openapi", "openrpc", "asyncapi", "json-schema", "protobuf", "protobuf-descriptor"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "stability": {"enum": ["experimental", "beta", "stable", "deprecated"]},
        "compatibility": {"enum": ["none", "backward", "forward", "full"]},
        "supersedes": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}@[A-Za-z0-9._-]{1,128}$"},
        "owner": {"type": "string", "maxLength": 256},
        "transports": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "media_types": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "labels": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "maxLength": 1024}}
      },
      "additionalProperties": false
    }
  }
}
