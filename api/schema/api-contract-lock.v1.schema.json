{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaverssh.dev/schema/api-contract-lock.v1.schema.json",
  "title": "WeaverSSH API Contract Lock",
  "type": "object",
  "required": ["version", "catalog_name", "revision", "catalog_sha256", "contracts"],
  "properties": {
    "version": {"const": "weaverssh.api-contract-lock.v1"},
    "catalog_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "contract_version", "kind", "path", "stability", "compatibility", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "contract_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "kind": {"enum": ["openapi", "openrpc", "asyncapi", "json-schema", "protobuf", "protobuf-descriptor"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "stability": {"enum": ["experimental", "beta", "stable", "deprecated"]},
        "compatibility": {"enum": ["none", "backward", "forward", "full"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "symbols": {"type": "array", "maxItems": 65536, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      },
      "additionalProperties": false
    }
  }
}
