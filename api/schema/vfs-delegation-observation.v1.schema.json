{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaverssh.dev/schema/vfs-delegation-observation.v1.schema.json",
  "title": "WeaverSSH VFS Delegation Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "invocation", "native", "success", "reduction", "summary"],
  "properties": {
    "version": {"const": "weaverssh.vfs-delegation-observation.v1"},
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": {"$ref": "vfs-delegation-request.v1.schema.json"}
      }
    },
    "handled_by": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "native": {"type": "boolean"},
    "success": {"type": "boolean"},
    "error": {"type": "string", "maxLength": 4096},
    "reduction": {"$ref": "#/$defs/reduction"},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"const": "weaverssh.vfs-delegation-reduction.v1"},
        "values": {
          "type": "object",
          "maxProperties": 65536,
          "propertyNames": {"pattern": "^[A-Za-z0-9._/-]{1,256}$"},
          "additionalProperties": {"$ref": "#/$defs/reducedValue"}
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "reducedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "strategy", "sources"],
      "properties": {
        "value": {},
        "strategy": {"enum": ["first", "last", "append", "sum", "min", "max", "bool-or", "bool-and", "set-union", "reject-conflict"]},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolved": {"type": "string", "maxLength": 4096},
        "name": {"type": "string", "maxLength": 4096},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "size": {"type": "integer"},
        "entry_count": {"type": "integer", "minimum": 0},
        "data_size": {"type": "integer", "minimum": 0},
        "data_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
