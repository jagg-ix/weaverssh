{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaverssh.dev/schema/origin-runtime-descriptor.v1.schema.json",
  "title": "WeaverSSH Origin Runtime Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "kind", "runtime_id", "guest_root", "capabilities", "config_sha256"],
  "properties": {
    "version": {"const": "weaverssh.origin-runtime-descriptor.v1"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "kind": {"enum": ["native", "wsl", "docker", "kubernetes", "vm"]},
    "runtime_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "guest_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "host_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "read_only": {"type": "boolean"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"enum": ["filesystem", "exec", "path-map"]}
    },
    "path_mappings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "guest"],
        "properties": {
          "host": {"type": "string", "minLength": 1, "maxLength": 4096},
          "guest": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "attributes": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]{1,128}$"},
      "additionalProperties": {"type": "string", "maxLength": 1024}
    },
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
