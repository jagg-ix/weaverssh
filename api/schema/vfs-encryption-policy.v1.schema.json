{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weaverssh.dev/schema/vfs-encryption-policy.v1.schema.json",
  "title": "WeaverSSH VFS Recipient Encryption Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "default"],
  "properties": {
    "version": {"const": "weaverssh.vfs-encryption-policy.v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9._-]{1,128}$"},
    "default": {"enum": ["plain", "encrypt"]},
    "default_recipients": {"$ref": "#/$defs/recipients"},
    "allow_plaintext_migration": {"type": "boolean", "default": false},
    "rules": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"default": {"const": "encrypt"}}},
      "then": {"required": ["default_recipients"], "properties": {"default_recipients": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"default": {"const": "plain"}}},
      "then": {"not": {"required": ["default_recipients"]}}
    }
  ],
  "$defs": {
    "recipients": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^x25519-[0-9a-f]{32}$"}
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "mode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9._-]{1,128}$"},
        "priority": {"type": "integer"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/\\\\\\u0000\\r\\n][^\\\\\\u0000\\r\\n]*$"}
        },
        "mode": {"enum": ["plain", "encrypt"]},
        "recipients": {"$ref": "#/$defs/recipients"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "encrypt"}}},
          "then": {"required": ["recipients"], "properties": {"recipients": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"mode": {"const": "plain"}}},
          "then": {"not": {"required": ["recipients"]}}
        }
      ]
    }
  }
}
