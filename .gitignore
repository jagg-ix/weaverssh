.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
.coverage.*
pip-wheel-metadata/

# Local environment overrides; commit explicit examples instead
.env
.env.local
*.local.ini
*.local.json

# Ansible local retry/cache output
*.retry
.ansible/

# Packaging outputs generated from tracked recipes/scripts
/packages/
/release/
/packaging/dist/
/packaging/output/
